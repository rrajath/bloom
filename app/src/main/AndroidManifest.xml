        <!--
          The Ledger widget's "+" button: same one-shot-errand pattern as
          RescheduleActivity below (empty taskAffinity, transparent window,
          excluded from recents) so the small composer overlays whatever app
          the user was in and finishing it never touches Grove's own task.
        -->
        <activity
            android:name=".widget.WidgetQuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Grove.Transparent"
            android:windowSoftInputMode="adjustResize" />

        <!--
          The Agenda widget's view picker (tap the widget title): same one-shot
          overlay pattern and flags as WidgetQuickAddActivity above.
        -->
        <activity
            android:name=".widget.WidgetViewPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Grove.Transparent" />

        <!-- SCHEDULED/DEADLINE reminder notifications. -->
