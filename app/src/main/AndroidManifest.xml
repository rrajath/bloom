<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fetch the page title for shared URLs so notes read better than a bare link. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SCHEDULED/DEADLINE reminder notifications (see the `reminders` package). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".GroveApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Grove">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Grove"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|touchscreen|locale|layoutDirection|colorMode|fontWeightAdjustment|mcc|mnc">
            <!-- bloom:// deep links (widget, notification, note shortcuts). grove:// is
                 the pre-rename scheme, kept so old pinned shortcuts and automations
                 keep working (ui/nav/DeepLinks.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bloom" />
                <data android:scheme="grove" />
            </intent-filter>
            <!--
              Open .org files: register Grove so it can be set as the default
              handler. Org has no registered MIME type, so this is split into two
              filters rather than one: Android ANDs every <data> constraint inside
              a single intent-filter together, so a filter combining mimeType with
              pathPattern only matches senders that satisfy both at once. Most
              callers don't: a file manager typically sends
              application/octet-stream (or no type at all) for an unrecognized
              extension, while a cloud provider's content:// URI often has an
              opaque path that doesn't literally end in ".org". Splitting lets
              either kind of match resolve to Grove on its own.
            -->
            <!-- Path-based: matches by filename extension, any (or no) MIME type. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <!-- Repeated pathPatterns work around Android's greedy `.*` not
                     spanning earlier dots in a file name (e.g. "notes.2026.org"). -->
                <data android:pathPattern=".*\\.org" />
                <data android:pathPattern=".*\\..*\\.org" />
                <data android:pathPattern=".*\\..*\\..*\\.org" />
            </intent-filter>
            <!-- MIME-type-based: matches providers that correctly tag org content,
                 regardless of what its content:// URI path looks like. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/org" />
                <data android:mimeType="text/x-org" />
            </intent-filter>
        </activity>

        <!--
          Share sheet target: text and URLs route into capture (PRD §10),
          silently, without bringing Grove's UI to the foreground. Theme.NoDisplay
          means this window is never actually shown, which requires finishing
          before the activity would need to draw — see ShareReceiverActivity.
        -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!--
          A reminder notification's "Reschedule" action. Its own empty
          taskAffinity puts it in a task separate from MainActivity's, so
          confirming a new date finishes it and returns the user to whatever app
          they pulled the notification shade down from; Grove's own task is
          neither launched nor disturbed. Excluded from recents for the same
          reason: it is a one-shot errand, not somewhere to come back to.
        -->
        <activity
            android:name=".ui.reminders.RescheduleActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Grove.Transparent"
            android:windowSoftInputMode="adjustResize" />

