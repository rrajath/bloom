<?xml version="1.0" encoding="utf-8"?>
<!-- tools:ignore UnusedAttribute: the API 31+ sizing attributes are ignored on older launchers, which use minWidth/minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="474dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/ledger_widget_description" />
