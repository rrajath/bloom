<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Counted nouns (ui/util/Plurals.kt countLabel). Use these only where the count stands
         alone as a label, e.g. the meta text under a notebook in a picker. A count inside a
         sentence ("Refiled 3 notes to inbox.org") gets its own whole-sentence <plurals>. -->
    <!-- A note is an org heading together with its body. -->
    <plurals name="count_notes">
    </plurals>
    <!-- A heading is an org headline ("* Title"). -->
    <plurals name="count_headings">
    </plurals>
    <!-- Files on disk, e.g. .org files inside a folder of the notes folder. -->
    <plurals name="count_files">
    </plurals>
    <plurals name="count_folders">
    </plurals>
    <!-- Links from other notes pointing at this one. -->
    <plurals name="count_backlinks">
    </plurals>
    <!-- Places in other notes that mention this note. -->
    <plurals name="count_references">
    </plurals>
    <!-- Shared actions. Reuse a key only where the meaning and grammar match. -->
    <string name="action_rename"></string>
    <string name="action_delete"></string>
    <!-- Reorder an item in a list (long-press menu). -->
    <string name="action_move_up"></string>
    <string name="action_move_down"></string>
    <!-- Dialog buttons. -->
    <string name="action_save"></string>
    <!-- Create a new file or folder (name dialog button). -->
    <string name="action_create"></string>
    <!-- Throw away unsaved changes or an unsaved note. -->
    <string name="action_discard"></string>
    <string name="action_ok"></string>
    <!-- The Read / Edit switch at the top of a note (ui/components/Common.kt ReadEditToggle). -->
    <string name="mode_read"></string>
    <string name="mode_edit"></string>
    <!-- Screen reader state of the Read / Edit switch. -->
    <string name="mode_read_state"></string>
    <string name="mode_edit_state"></string>
    <!-- Screen reader action for the round button that opens a note's metadata (dates, tags, properties). -->
    <string name="metadata_fab_open"></string>
    <!-- Location picker (refile, archive, capture targets). %1$s = notebook name without .org. -->
    <string name="location_open_failed"></string>
    <string name="location_notebook_exists"></string>
    <!-- Snackbar after marking a heading done moved it to its archive location. %1$s = where it went (notebook and heading). -->
    <string name="snack_marked_done_refiled"></string>
    <!-- Swipe cells on Agenda and Search result rows. The cells are narrow: keep these short. -->
    <!-- Mark the task done. -->
    <string name="swipe_done"></string>
    <!-- Open the heading in its notebook's outline. -->
    <string name="swipe_reveal"></string>
    <!-- More shared actions. -->
    <string name="action_close"></string>
    <!-- Remove a value, e.g. clear all dates or the reminder time. -->
    <string name="action_clear"></string>
    <!-- Close a picker after choosing. -->
    <string name="action_done"></string>
    <!-- Undo action on the undo snackbar. Shown in capitals. -->
    <string name="action_undo"></string>
    <!-- Snackbar after marking a heading done. -->
    <string name="snack_marked_done"></string>
    <!-- Snackbar after marking a recurring heading done. %1$s = the next date, e.g. "Jun 5th". -->
    <string name="snack_marked_done_next"></string>
    <!-- Directory field (capture template folder, Roam folder): the top folder of the notes folder. -->
    <string name="directory_vault_root"></string>
    <!-- Screen reader labels for the jump buttons on long notes. -->
    <string name="scroll_to_top"></string>
    <string name="scroll_to_bottom"></string>
    <!-- Colour picker for a notebook or template icon (long press on the icon). -->
    <string name="monogram_change_color"></string>
    <!-- Section header in the colour picker. Shown in capitals. -->
    <string name="monogram_color_header"></string>
    <!-- Why a heading tag can't be used (tag field in the metadata sheet, Settings). -->
    <string name="tag_error_empty"></string>
    <string name="tag_error_spaces"></string>
    <string name="tag_error_colons"></string>
    <!-- Keep the symbols _ @ # % - as they are: they are the characters org-mode allows. -->
    <string name="tag_error_charset"></string>
</resources>
