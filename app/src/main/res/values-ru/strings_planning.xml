<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Planning dates screen (ui/components/PlanningDatesScreen.kt): the full-screen
         picker for a heading's SCHEDULED, DEADLINE and active timestamps.
         "SCHEDULED" and "DEADLINE" are org-mode keywords and stay in English. -->

    <!-- Tab for the heading's active timestamps (<2026-01-05 Mon>), next to the
         SCHEDULED and DEADLINE tabs. Shown in capitals. -->
    <string name="planning_tab_active"></string>
    <!-- Shown after tapping the already-selected day, which clears the date. -->
    <string name="planning_cleared_note"></string>
    <string name="planning_help_active"></string>
    <string name="planning_help_single"></string>
    <!-- Editing several notes at once. %1$s: the tab, e.g. SCHEDULED. -->
    <string name="planning_mixed_dates"></string>
    <string name="planning_remove_from_all"></string>
    <!-- %1$s: the tab, e.g. SCHEDULED. -->
    <string name="planning_removed_from_all_note"></string>
    <plurals name="planning_timestamp_count">
    </plurals>
    <string name="planning_apply_dates"></string>
    <!-- Quick date chips; the date follows, e.g. "Tomorrow · Jan 6". -->
    <string name="planning_preset_today"></string>
    <string name="planning_preset_tomorrow"></string>
    <string name="planning_preset_this_weekend"></string>
    <string name="planning_preset_next_week"></string>
    <!-- Time row: "Time · All day" or "Time · 09:00 – 10:00". -->
    <string name="planning_time"></string>
    <string name="planning_all_day"></string>
    <!-- Between the start and end time fields: "09:00 to 10:00". -->
    <string name="planning_time_to"></string>
    <string name="planning_repeat"></string>
    <!-- Repeat unit chips. -->
    <string name="planning_unit_chip_day"></string>
    <string name="planning_unit_chip_week"></string>
    <string name="planning_unit_chip_month"></string>
    <string name="planning_unit_chip_year"></string>
    <!-- The repeat sentence. %1$s: the interval ("week", "2 weeks"); %2$s: what happens
         when the task is done late (planning_repeat_kind_*). Both are tappable. -->
    <string name="planning_repeat_sentence"></string>
    <!-- A repeat interval of one unit, as in "Every week". -->
    <string name="planning_unit_day"></string>
    <string name="planning_unit_week"></string>
    <string name="planning_unit_month"></string>
    <string name="planning_unit_year"></string>
    <string name="planning_unit_hour"></string>
    <!-- A repeat interval of several units, as in "Every 2 weeks". -->
    <plurals name="planning_units_day">
    </plurals>
    <plurals name="planning_units_week">
    </plurals>
    <plurals name="planning_units_month">
    </plurals>
    <plurals name="planning_units_year">
    </plurals>
    <plurals name="planning_units_hour">
    </plurals>
    <!-- One unit, as in "Moves on by exactly one week". -->
    <string name="planning_one_day"></string>
    <string name="planning_one_week"></string>
    <string name="planning_one_month"></string>
    <string name="planning_one_year"></string>
    <string name="planning_one_hour"></string>
    <!-- org repeater kinds: +1w, .+1w, ++1w. They end planning_repeat_sentence. -->
    <string name="planning_repeat_kind_cumulative"></string>
    <string name="planning_repeat_kind_catch_up"></string>
    <string name="planning_repeat_kind_future"></string>
    <!-- %1$s: the interval, e.g. "one week" or "2 weeks". -->
    <string name="planning_repeat_hint_cumulative"></string>
    <string name="planning_repeat_hint_catch_up"></string>
    <!-- DONE is the org-mode keyword; keep it as is. -->
    <string name="planning_repeat_hint_future"></string>
    <!-- Shorthand field echo: "Fri, Jan 9 · tomorrow  ·  every week +1w  → SCHEDULED". -->
    <string name="planning_relative_today"></string>
    <string name="planning_relative_tomorrow"></string>
    <string name="planning_relative_yesterday"></string>
    <plurals name="planning_relative_in_days">
    </plurals>
    <plurals name="planning_relative_days_ago">
    </plurals>
    <!-- %1$s: the interval ("week", "2 weeks"); %2$s: the org repeater cookie, e.g. +1w. -->
    <string name="planning_echo_every"></string>
    <!-- The examples are shorthand the date field understands, which is English only:
         keep %1$s, %2$s and %3$s (fri, +2w, aug 3 10-11am); change only the quotes. -->
    <string name="planning_shorthand_not_understood"></string>
    <!-- Insert-timestamp screen (editor toolbar clock button, long press). -->
    <string name="planning_insert_active_help"></string>
    <string name="planning_insert_inactive_help"></string>
    <string name="planning_make_inactive"></string>
    <string name="planning_make_active"></string>
    <string name="planning_apply_date"></string>
</resources>
