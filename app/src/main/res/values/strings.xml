<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Bloom</string>
    <string name="widget_description">One-tap capture into your org notes</string>
    <string name="ledger_widget_description">Agenda ledger: overdue and upcoming tasks grouped by day</string>
    <!-- %1$s is the app name (R.string.app_name), never hardcoded. -->
    <string name="exact_alarm_prompt_body">Android can delay %1$s\'s reminders by up to an hour unless %1$s is allowed to set alarms. On the next screen, turn on Alarms &amp; reminders for %1$s.</string>
    <!-- Shared live search in the insert-link and refile pickers (ui/components/PickerSearch.kt). -->
    <string name="picker_search_placeholder">Search files and headings</string>
    <string name="picker_search_results_header">FILES &amp; HEADINGS</string>
    <string name="picker_search_no_matches">No matches</string>
    <string name="picker_search_file_crumb">file</string>
    <string name="picker_search_heading_meta">heading</string>
    <string name="picker_search_headings_placeholder">Search headings</string>
    <string name="picker_search_headings_header">HEADINGS</string>
    <string name="heading_id_tag">ID</string>
    <string name="refile_search_stale_heading">That heading no longer exists</string>
    <!-- Agenda widget view picker (widget/LedgerWidget.kt, widget/WidgetViewPickerActivity.kt). -->
    <string name="widget_view_agenda">Agenda</string>
    <string name="widget_view_caret">▾</string>
    <string name="widget_view_picker_title">Show in widget</string>
    <string name="widget_view_change">Change widget view</string>
    <string name="widget_view_current">Current view</string>
    <!-- %1$s is the app name (R.string.app_name), never hardcoded. -->
    <string name="widget_open_agenda">Open Agenda in %1$s</string>
    <string name="widget_no_results">No results</string>
    <!-- "+N more" (load the next page in the widget) and "view all" (open the app) are separate tap targets. -->
    <string name="widget_load_more" tools:ignore="PluralsCandidate">+%1$d more</string>
    <string name="widget_more_separator">·</string>
    <string name="widget_view_all">view all</string>
    <!-- View picker subtitle for the Agenda row; %1$d is Settings › Widget › Days ahead. -->
    <plurals name="widget_view_agenda_window">
        <item quantity="one">Overdue + next %1$d day</item>
        <item quantity="other">Overdue + next %1$d days</item>
    </plurals>
    <!-- Search's Quick Start cards (ui/search/QuickStarts.kt), also offered as Agenda widget views.
         Keep in step with QuickStartOverrides.idForName, which matches these exact names. -->
    <string name="quick_start_overdue">Overdue</string>
    <string name="quick_start_today">Today</string>
    <string name="quick_start_open_tasks">Open tasks</string>
    <string name="quick_start_unscheduled">Unscheduled</string>
    <plurals name="widget_result_count">
        <item quantity="one">%1$d result</item>
        <item quantity="other">%1$d results</item>
    </plurals>
    <!-- Attachments: chooser titles (attach/AttachmentIntents.kt). -->
    <string name="attach_open_with">Open with</string>
    <string name="attach_share">Share</string>
    <string name="attach_empty_file_no_id">No attachments yet. %1$s adds an :ID: to this file the first time you attach.</string>
    <!-- Settings › Tips &amp; Tricks, Outline group (ui/screens/settings/SettingsTipsScreen.kt).
         {{menu}} is drawn as the ⋮ button's keycap: keep the marker as-is when translating. -->
    <string name="tips_group_outline">Outline</string>
    <string name="tip_outline_view_file_title">Double-tap below the outline to view the whole file</string>
    <string name="tip_outline_view_file_body">In a notebook\'s outline, double-tap the empty space below the last heading to open the whole file as one note, the same as View file in the {{menu}} menu.</string>
    <!-- Outline: why a file can't open as one note (the disabled ⋮ › View file hint, and the toast
         for a double-tap below the last heading). %1$d is the file's line count. -->
    <plurals name="outline_whole_file_too_large">
        <item quantity="one">Too large to open whole (%1$d line). Open a heading instead.</item>
        <item quantity="other">Too large to open whole (%1$d lines). Open a heading instead.</item>
    </plurals>
    <!-- Storage errors (ui/vault/StorageMessages.kt): why a create, rename, move, delete or save
         didn't go through. "Storage provider" is the app that holds the vault folder (Seafile,
         Nextcloud, a cloud-sync folder). %1$s in the detail string is the provider's own message. -->
    <!-- Storage provider names, for "<provider> doesn't let other apps rename files" and Settings > Sync. -->
    <string name="storage_provider_generic">Your storage provider</string>
    <string name="storage_provider_local">Local storage</string>
    <string name="storage_provider_seafile" translatable="false">Seafile</string>
    <string name="storage_provider_nextcloud" translatable="false">Nextcloud</string>
    <string name="storage_verb_rename">rename</string>
    <string name="storage_verb_move">move</string>
    <string name="storage_verb_delete">delete</string>
    <string name="storage_verb_or">or</string>
    <string name="settings_sync_provider">Provider</string>
    <string name="settings_sync_provider_full">Rename, move and delete all work</string>
    <string name="settings_sync_provider_limited">Doesn\'t let other apps %1$s files</string>
    <string name="storage_error_name_taken_notebook">A notebook with that name already exists</string>
    <string name="storage_error_name_taken_folder">A folder with that name already exists</string>
    <string name="storage_error_not_found">That item is no longer there. Sync and try again.</string>
    <string name="storage_error_unsupported_create">%1$s doesn\'t let other apps create files.</string>
    <string name="storage_error_unsupported_create_folder">%1$s doesn\'t let other apps create folders.</string>
    <string name="storage_error_unsupported_rename">%1$s doesn\'t let other apps rename files.</string>
    <string name="storage_error_unsupported_move">%1$s doesn\'t let other apps move files.</string>
    <string name="storage_error_unsupported_delete">%1$s doesn\'t let other apps delete files.</string>
    <string name="storage_error_unsupported_write">%1$s doesn\'t let other apps change files.</string>
    <string name="storage_error_unsupported_read">%1$s doesn\'t let other apps read files.</string>
    <string name="storage_error_provider">Your storage provider refused the change.</string>
    <string name="storage_error_provider_detail">Your storage provider refused the change: %1$s</string>
    <string name="storage_error_offline">Can\'t reach your storage provider. Nothing was changed.</string>
    <string name="storage_error_conflict">This file changed somewhere else. Reload it before saving.</string>
    <!-- Conflict screen, when the provider won't let Bloom delete the conflict copy. %1$s: provider. -->
    <string name="conflict_copy_kept_note">%1$s doesn\'t let other apps delete files, so delete the copy there afterwards.</string>
    <!-- %1$s: the copy's path, %2$s: provider, %3$s: app name. -->
    <string name="conflict_cleanup_needed">Saved. %2$s doesn\'t let other apps delete files: delete %1$s in %2$s to finish cleaning up. Until then, %3$s keeps flagging this conflict.</string>
    <string name="storage_error_auth_failed">Your storage provider needs you to sign in again.</string>

    <!-- Offline mode (ui/components/StorageBanners.kt): the vault's provider can't be reached, so the
         notebooks shown are the last synced ones and nothing can be changed. -->
    <string name="offline_banner_message">Can\'t reach your storage provider. Showing your last synced notebooks, read only.</string>
    <string name="offline_editor_read_only">Offline: this note is read only until your storage provider is back.</string>
    <string name="offline_banner_retry">Retry</string>
</resources>
