<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Counted nouns (ui/util/Plurals.kt countLabel). Use these only where the count stands
         alone as a label, e.g. the meta text under a notebook in a picker. A count inside a
         sentence ("Refiled 3 notes to inbox.org") gets its own whole-sentence <plurals>. -->
    <!-- A note is an org heading together with its body. -->
    <plurals name="count_notes">
        <item quantity="one">%d note</item>
        <item quantity="other">%d notes</item>
    </plurals>
    <!-- A heading is an org headline ("* Title"). -->
    <plurals name="count_headings">
        <item quantity="one">%d heading</item>
        <item quantity="other">%d headings</item>
    </plurals>
    <!-- Files on disk, e.g. .org files inside a folder of the notes folder. -->
    <plurals name="count_files">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>
    <plurals name="count_folders">
        <item quantity="one">%d folder</item>
        <item quantity="other">%d folders</item>
    </plurals>
    <!-- Links from other notes pointing at this one. -->
    <plurals name="count_backlinks">
        <item quantity="one">%d backlink</item>
        <item quantity="other">%d backlinks</item>
    </plurals>
    <!-- Places in other notes that mention this note. -->
    <plurals name="count_references">
        <item quantity="one">%d reference</item>
        <item quantity="other">%d references</item>
    </plurals>

    <!-- Shared actions. Reuse a key only where the meaning and grammar match. -->
    <string name="action_rename">Rename</string>
    <string name="action_delete">Delete</string>
    <!-- Reorder an item in a list (long-press menu). -->
    <string name="action_move_up">Move up</string>
    <string name="action_move_down">Move down</string>
    <!-- Dialog buttons. -->
    <string name="action_save">Save</string>
    <!-- Create a new file or folder (name dialog button). -->
    <string name="action_create">Create</string>
    <!-- Throw away unsaved changes or an unsaved note. -->
    <string name="action_discard">Discard</string>
    <string name="action_ok">OK</string>

    <!-- The Read / Edit switch at the top of a note (ui/components/Common.kt ReadEditToggle). -->
    <string name="mode_read">Read</string>
    <string name="mode_edit">Edit</string>
    <!-- Screen reader state of the Read / Edit switch. -->
    <string name="mode_read_state">Read mode</string>
    <string name="mode_edit_state">Edit mode</string>
    <!-- Screen reader action for the round button that opens a note's metadata (dates, tags, properties). -->
    <string name="metadata_fab_open">Open metadata</string>

    <!-- Location picker (refile, archive, capture targets). %1$s = notebook name without .org. -->
    <string name="location_open_failed">Couldn\'t open %1$s</string>
    <string name="location_notebook_exists">A notebook with that name already exists</string>

    <!-- Snackbar after marking a heading done moved it to its archive location. %1$s = where it went (notebook and heading). -->
    <string name="snack_marked_done_refiled">Marked done. Refiled to %1$s</string>
    <!-- Swipe cells on Agenda and Search result rows. The cells are narrow: keep these short. -->
    <!-- Mark the task done. -->
    <string name="swipe_done">Done</string>
    <!-- Open the heading in its notebook's outline. -->
    <string name="swipe_reveal">Reveal</string>

    <!-- More shared actions. -->
    <string name="action_close">Close</string>
    <!-- Remove a value, e.g. clear all dates or the reminder time. -->
    <string name="action_clear">Clear</string>
    <!-- Close a picker after choosing. -->
    <string name="action_done">Done</string>
    <!-- Undo action on the undo snackbar. Shown in capitals. -->
    <string name="action_undo">Undo</string>
    <!-- Snackbar after marking a heading done. -->
    <string name="snack_marked_done">Marked done</string>
    <!-- Snackbar after marking a recurring heading done. %1$s = the next date, e.g. "Jun 5th". -->
    <string name="snack_marked_done_next">Marked done. Next occurrence %1$s</string>
    <!-- Directory field (capture template folder, Roam folder): the top folder of the notes folder. -->
    <string name="directory_vault_root">(Vault root)</string>
    <!-- Screen reader labels for the jump buttons on long notes. -->
    <string name="scroll_to_top">Scroll to top</string>
    <string name="scroll_to_bottom">Scroll to bottom</string>
    <!-- Colour picker for a notebook or template icon (long press on the icon). -->
    <string name="monogram_change_color">Change icon color</string>
    <!-- Section header in the colour picker. Shown in capitals. -->
    <string name="monogram_color_header">Color</string>
    <!-- Why a heading tag can't be used (tag field in the metadata sheet, Settings). -->
    <string name="tag_error_empty">Enter a tag.</string>
    <string name="tag_error_spaces">Tags can\'t contain spaces.</string>
    <string name="tag_error_colons">Tags can\'t contain colons.</string>
    <!-- Keep the symbols _ @ # % - as they are: they are the characters org-mode allows. -->
    <string name="tag_error_charset">Use letters, numbers, _ @ # % or -.</string>
</resources>
